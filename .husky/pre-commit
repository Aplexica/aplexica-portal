#!/usr/bin/env sh

# Block commits that introduce TS/TSX/JS/MJS/CSS files without an SPDX header.
# The codemod (tools/agpl-header-codemod.mjs) lands headers retroactively;
# this guard prevents new files from regressing the invariant.

files=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.(ts|tsx|js|mjs|css)$' || true)
if [ -z "$files" ]; then
  exit 0
fi

missing=0
for f in $files; do
  case "$f" in
    src/*|tools/*)
      # Allow shebang on line 1, SPDX on line 1 or 2.
      head -n 2 "$f" | grep -qE 'SPDX-License-Identifier' || {
        echo "missing SPDX header: $f"
        missing=1
      }
      ;;
  esac
done

[ "$missing" -eq 1 ] && exit 1 || exit 0
